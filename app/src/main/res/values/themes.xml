<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Тема приложения. Наследуется от Material Components:
         этого требует компонент BottomSheet из библиотеки UIKit.
         Цвета берутся из палитры UIKit. -->
    <style name="Theme.Matule" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>
