<?xml version="1.0" encoding="utf-8"?>
<!-- Содержимое BottomSheet карточки товара -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/productTitle"
            style="@style/Text.Title2.Semibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ru.samoylov.matule.uikit.AppIcon
            android:id="@+id/closeIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_counter_button"
            android:textColor="@color/description"
            app:iconName="close"
            app:iconSize="16dp" />

    </LinearLayout>

    <TextView
        style="@style/Text.Headline.Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Описание"
        android:textColor="@color/placeholder" />

    <TextView
        android:id="@+id/productDescription"
        style="@style/Text.Headline.Regular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp" />

    <TextView
        style="@style/Text.Body.Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Примерный расход:"
        android:textColor="@color/placeholder" />

    <TextView
        android:id="@+id/productConsumption"
        style="@style/Text.Headline.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <ru.samoylov.matule.uikit.AppButton
        android:id="@+id/productButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />

</LinearLayout>
