<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «Создание профиля» -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.Title1.Semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:text="Создание Профиля" />

        <TextView
            style="@style/Text.Caption.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Без профиля вы не сможете создавать проекты."
            android:textColor="@color/placeholder" />

        <TextView
            style="@style/Text.Caption.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="В профиле будут храниться результаты проектов и ваши описания."
            android:textColor="@color/placeholder" />

        <ru.samoylov.matule.uikit.AppInput
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:inputHint="Имя" />

        <ru.samoylov.matule.uikit.AppInput
            android:id="@+id/patronymicInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:inputHint="Отчество" />

        <ru.samoylov.matule.uikit.AppInput
            android:id="@+id/surnameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:inputHint="Фамилия" />

        <ru.samoylov.matule.uikit.AppInput
            android:id="@+id/birthDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:inputFieldType="date"
            app:inputHint="Дата рождения" />

        <ru.samoylov.matule.uikit.AppSelect
            android:id="@+id/genderSelect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:selectPlaceholder="Пол" />

        <ru.samoylov.matule.uikit.AppInput
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:inputFieldType="email"
            app:inputHint="Почта" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

        <ru.samoylov.matule.uikit.AppButton
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Далее" />

    </LinearLayout>

</ScrollView>
