<?xml version="1.0" encoding="utf-8"?>
<!-- Фон инпута, селекта и поиска: обычное состояние, фокус и disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_bg" />
            <stroke android:width="1dp" android:color="@color/input_focus_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/input_bg" />
            <stroke android:width="1dp" android:color="@color/input_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
